  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: 'Segoe UI';
    font-size: 13px;
}
QLabel#headerLabel {
    color: #cba6f7;
    font-size: 16px;
    font-weight: bold;
}
QLabel#descLabel      { color: #a6adc8; font-size: 12px; }
QLabel#fieldLabel     { color: #cdd6f4; min-width: 110px; }
QLabel#errorLabel     { color: #f38ba8; font-size: 11px; }
QLabel#connectingLabel { color: #a6e3a1; font-size: 13px; font-weight: bold; }
QLabel#ipLabel        { color: #a6e3a1; font-size: 14px; font-weight: bold; }
QLineEdit, QSpinBox {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 8px 12px;
    color: #cdd6f4;
}
QLineEdit:focus, QSpinBox:focus { border-color: #89b4fa; }
QSpinBox::up-button, QSpinBox::down-button {
    background: #45475a;
    border-radius: 4px;
    width: 18px;
}
QPushButton#hostBtn {
    background-color: #313244;
    border: 2px solid #fab387;
    border-radius: 10px;
    color: #fab387;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 16px;
}
QPushButton#hostBtn:hover { background-color: #fab387; color: #1e1e2e; }
QPushButton#guestBtn {
    background-color: #313244;
    border: 2px solid #89b4fa;
    border-radius: 10px;
    color: #89b4fa;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 16px;
}
QPushButton#guestBtn:hover { background-color: #89b4fa; color: #1e1e2e; }
QPushButton#primaryBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    min-height: 44px;
}
QPushButton#primaryBtn:hover   { background-color: #b4befe; }
QPushButton#primaryBtn:pressed { background-color: #cba6f7; }
QPushButton#cancelBtn {
    background-color: #313244;
    border: 1px solid #f38ba8;
    border-radius: 8px;
    color: #f38ba8;
    min-height: 40px;
}
QPushButton#cancelBtn:hover { background-color: #f38ba8; color: #1e1e2e; }
QPushButton#linkBtn {
    color: #6c7086;
    border: none;
    font-size: 11px;
    background: transparent;
    text-decoration: underline;
}
QPushButton#linkBtn:hover { color: #cdd6f4; }
QCheckBox#timerCheck { color: #cdd6f4; spacing: 8px; }
QCheckBox#timerCheck::indicator {
    width: 18px; height: 18px;
    border: 1px solid #45475a;
    border-radius: 4px;
    background: #313244;
}
QCheckBox#timerCheck::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}
QWidget#infoCard {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 10px;
    padding: 12px;
}
