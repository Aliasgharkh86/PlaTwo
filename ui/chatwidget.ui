   <string notr="true">
ChatWidget {
    background-color: #1e1e2e;
    border-left: 1px solid #313244;
}
QLabel#chatTitle {
    color: #cba6f7;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 0;
}
QLabel#stickerLabel {
    color: #6c7086;
    font-size: 11px;
}
QTextEdit#chatDisplay {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    color: #cdd6f4;
    font-size: 12px;
    padding: 6px;
}
QLineEdit#chatInput {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    color: #cdd6f4;
    font-size: 12px;
    padding: 6px 10px;
}
QLineEdit#chatInput:focus { border-color: #89b4fa; }
QPushButton#sendBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
    min-height: 36px;
}
QPushButton#sendBtn:hover { background-color: #b4befe; }
QPushButton#stickerBtn1, QPushButton#stickerBtn2,
QPushButton#stickerBtn3, QPushButton#stickerBtn4,
QPushButton#stickerBtn5, QPushButton#stickerBtn6,
QPushButton#stickerBtn7, QPushButton#stickerBtn8 {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    font-size: 16px;
    min-width: 40px;
    min-height: 36px;
}
QPushButton#stickerBtn1:hover, QPushButton#stickerBtn2:hover,
QPushButton#stickerBtn3:hover, QPushButton#stickerBtn4:hover,
QPushButton#stickerBtn5:hover, QPushButton#stickerBtn6:hover,
QPushButton#stickerBtn7:hover, QPushButton#stickerBtn8:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}
